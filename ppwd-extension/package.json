{
  "name": "ppwd-extension",
  "version": "26.9.9",
  "description": "PPWD 浏览器扩展 — 网页自动填充、保险库管理与两步验证",
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS='--max-old-space-size=4096' vite",
    "build": "pnpm run typecheck && vite build",
    "package": "pnpm run build && node scripts/package-zip.mjs",
    "preview": "vite preview",
    "test:locale": "node --experimental-strip-types --test tests/locale.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.10.1",
    "lucide-react": "0.468.0",
    "otpauth": "^9.5.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.2",
    "tailwind-merge": "^3.7.0",
    "tssrp6a": "^3.0.0",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "@types/chrome": "^0.0.287",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "tailwindcss": "3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "author": "薛伟同学",
  "license": "MIT"
}
