{
  "name": "ppwd-desktop",
  "version": "26.9.9",
  "displayVersion": "26.9.9",
  "description": "PPWD - 简洁、安全、专业的桌面密码管理工具",
  "main": "out/main/index.js",
  "author": "薛伟同学",
  "license": "MIT",
  "scripts": {
    "dev": "env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "build": "pnpm run typecheck && electron-vite build",
    "test:phone-token": "node --experimental-strip-types --test tests/phoneToken.test.mjs",
    "test:encrypted-backup": "node --experimental-strip-types --test tests/encryptedVaultBackup.test.mjs",
    "test:theme-migration": "node --experimental-strip-types --test tests/themePreferenceMigration.test.mjs",
    "test:reactive-store": "node --experimental-strip-types --test tests/reactiveStore.test.mjs",
    "preview": "env -u ELECTRON_RUN_AS_NODE electron-vite preview",
    "generate:icons": "node scripts/generate-icons.mjs",
    "build:mac": "pnpm run build && electron-builder --mac && node scripts/after-mac-build.mjs",
    "build:win": "pnpm run generate:icons && pnpm run build && electron-builder --win --x64 && node scripts/after-win-build.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-toast": "^1.3.1",
    "electron-windows-security": "^0.0.7",
    "jsqr": "^1.4.0",
    "lucide-react": "0.468.0",
    "marked": "^18.0.5",
    "otpauth": "^9.5.1",
    "qrcode-generator": "2.0.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.2",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "^10.6.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "png-to-ico": "^2.1.8",
    "postcss": "^8.5.32",
    "sass": "^1.83.0",
    "sharp": "^0.33.5",
    "tailwindcss": "3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.bear.password",
    "productName": "PPWD",
    "copyright": "Copyright © 2026 薛伟同学",
    "directories": {
      "output": "../release",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/icon.icns",
        "to": "icons/icon.icns"
      },
      {
        "from": "resources/icon.ico",
        "to": "icons/icon.ico"
      },
      {
        "from": "resources/icon.png",
        "to": "icons/icon.png"
      },
      {
        "from": "resources/tray-icon.png",
        "to": "icons/tray-icon.png"
      }
    ],
    "asar": true,
    "protocols": [
      {
        "name": "PPWD URL",
        "schemes": [
          "ppwd",
          "bearpassword"
        ]
      }
    ],
    "mac": {
      "icon": "resources/icon.icns",
      "category": "public.app-category.productivity",
      "extendInfo": {
        "CFBundleShortVersionString": "26.9.9"
      },
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "artifactName": "${productName}.${ext}",
      "identity": "-",
      "entitlements": "build/mac/entitlements.mac.plist",
      "entitlementsInherit": "build/mac/entitlements.mac.plist",
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "PPWD",
      "icon": "resources/icon.icns",
      "sign": false,
      "window": {
        "width": 540,
        "height": 400
      },
      "contents": [
        {
          "x": 140,
          "y": 190,
          "type": "file"
        },
        {
          "x": 400,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "icon": "resources/icon.ico",
      "executableName": "PPWD",
      "artifactName": "PPWD-Setup.${ext}",
      "signAndEditExecutable": true,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PPWD",
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico",
      "installerHeaderIcon": "resources/icon.ico",
      "unicode": true,
      "artifactName": "PPWD-Setup.${ext}"
    }
  }
}
